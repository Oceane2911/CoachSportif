{% extends 'base.html.twig' %}

{% block title %}Prestation index
{% endblock %}
{% block stylesheets %}{% endblock %}

{% block body %}
	<h1>Dashboard</h1>

	<div class="table-wrapped">
		<table class="table">
			<thead>
				<tr>
					{# <th>Id</th> #}
					<th>Nom</th>
					<th>Prenom</th>
					<th>Email</th>
					<th>Tel</th>
					<th>Date</th>
					<th>Type Séance</th>
					<th>Coach</th>
					<th>Show</th>

				</tr>
			</thead>
			<tbody>
				{% for prestation in prestations %}
					{% if prestation.isValid %}
						<tr>
							{# <td>{{ prestation.id }}</td> #}
							<td>{{ prestation.nom }}</td>
							<td>{{ prestation.prenom }}</td>
							<td>{{ prestation.email }}</td>
							<td>{{ prestation.tel }}</td>
							<td>{{ prestation.date ? prestation.date|date('Y-m-d H:i:s') : '' }}</td>
							<td>{{ prestation.motif.nom}}</td>
							<td>{{ prestation.coach.nom}} {{prestation.coach.prenom}}</td>
							<td>
								<a href="{{ path('app_prestation_show', {'id': prestation.id}) }}">show</a>
							</td>
						</tr>
					{% endif %}
				{% else %}
					<tr>
						<td colspan="7">Pas de rendez-vous</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock %}
